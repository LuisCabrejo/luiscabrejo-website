// Función para determinar el fallback apropiado
function selectAppropiateFallback(message: string): string {
  const lowerMessage = message.toLowerCase();

  if (lowerMessage.includes('hola') || lowerMessage.includes('buenos') || lowerMessage.includes('buenas')) {
    return NEXUS_FALLBACKS.greeting;
  }

  if (lowerMessage.includes('quien eres') || lowerMessage.includes('qué eres') || lowerMessage.includes('nexus')) {
    return NEXUS_FALLBACKS.identity;
  }

  if (lowerMessage.includes('funciona') || lowerMessage.includes('negocio') || lowerMessage.includes('4m') || lowerMessage.includes('sistema')) {
    return NEXUS_FALLBACKS.business;
  }

  if (lowerMessage.includes('cuesta') || lowerMessage.includes('dinero') || lowerMessage.includes('invertir') || lowerMessage.includes('paquete')) {
    return NEXUS_FALLBACKS.investment;
  }

  if (lowerMessage.includes('mlm') || lowerMessage.includes('legítimo') || lowerMessage.includes('estafa') || lowerMessage.includes('confiable')) {
    return NEXUS_FALLBACKS.legitimacy;
  }

  return NEXUS_FALLBACKS.default;
}

// Función de retry con backoff exponencial
async function retryWithBackoff<T>(
  fn: () => Promise<T>,
  maxRetries: number = 3,
  baseDelay: number = 1000
): Promise<T> {
  for (let i = 0; i < maxRetries; i++) {
    try {
      return await fn();
    } catch (error) {
      if (i === maxRetries - 1) throw error;

      const delay = baseDelay * Math.pow(2, i) + Math.random() * 1000;
      await new Promise(resolve => setTimeout(resolve, delay));
    }
  }
  throw new Error('Max retries exceeded');
}

// Verificar circuit breaker
function isCircuitOpen(): boolean {
  if (failureCount >= CIRCUIT_BREAKER_THRESHOLD) {
    const timeSinceLastFailure = Date.now() - lastFailureTime;
    if (timeSinceLastFailure < CIRCUIT_BREAKER_TIMEOUT) {
      return true;
    } else {
      // Reset circuit breaker después del timeout
      failureCount = 0;
    }
  }
  return false;
}

// Registrar fallo en circuit breaker
function recordFailure(): void {
  failureCount++;
  lastFailureTime = Date.now();
}

// Registrar éxito en circuit breaker
function recordSuccess(): void {
  failureCount = 0;
}

export async function POST(request: NextRequest) {
  const startTime = Date.now();

  try {
    const { message, conversationHistory = [] } = await request.json();

    if (!message || typeof message !== 'string') {
      return NextResponse.json(
        { error: 'Message is required and must be a string' },
        { status: 400 }
      );
    }

    // Verificar circuit breaker ANTES de intentar llamada a Claude
    if (isCircuitOpen()) {
      console.log('Circuit breaker OPEN - usando fallback directamente');
      return NextResponse.json({
        message: selectAppropiateFallback(message),
        responseTime: Date.now() - startTime,
        source: 'circuit_breaker_fallback',
        timestamp: new Date().toISOString()
      });
    }

    // Construir historial de conversación para Claude
    const messages = [
      ...conversationHistory.map((msg: any) => ({
        role: msg.role === 'user' ? 'user' : 'assistant',
        content: msg.content
      })),
      {
        role: 'user' as const,
        content: message
      }
    ];

    // Intentar llamada a Claude con retry y circuit breaker
    try {
      const response = await retryWithBackoff(async () => {
        return await anthropic.messages.create({
          model: 'claude-3-5-sonnet-20241022',
          max_tokens: 1500,
          temperature: 0.7,
          system: NEXUS_SYSTEM_PROMPT,
          messages: messages,
          timeout: 30000 // 30 segundos explícito
        });
      }, 2, 2000); // 2 retries, base delay 2 segundos

      recordSuccess(); // Circuit breaker éxito

      const responseTime = Date.now() - startTime;

      return NextResponse.json({
        message: response.content[0].type === 'text' ? response.content[0].text : 'Respuesta no disponible',
        responseTime,
        source: 'claude_api',
        timestamp: new Date().toISOString(),
        usage: {
          input_tokens: response.usage?.input_tokens || 0,
          output_tokens: response.usage?.output_tokens || 0
        }
      });

    } catch (claudeError: any) {
      recordFailure(); // Circuit breaker fallo

      console.error('Claude API error after retries:', {
        error: claudeError.message,
        status: claudeError.status,
        type: claudeError.type,
        failureCount,
        circuitOpen: isCircuitOpen()
      });

      // Usar fallback inteligente después de fallo de Claude
      const responseTime = Date.now() - startTime;

      return NextResponse.json({
        message: selectAppropiateFallback(message),
        responseTime,
        source: 'intelligent_fallback_after_claude_error',
        timestamp: new Date().toISOString(),
        error_info: {
          type: claudeError.type || 'unknown',
          status: claudeError.status || 'unknown',
          failureCount
        }
      });
    }

  } catch (error: any) {
    console.error('NEXUS API general error:', error);

    const responseTime = Date.now() - startTime;

    return NextResponse.json({
      message: NEXUS_FALLBACKS.technical_difficulty,
      responseTime,
      source: 'general_error_fallback',
      timestamp: new Date().toISOString(),
      error: process.env.NODE_ENV === 'development' ? error.message : 'Internal server error'
    }, { status: 500 });
  }
}

